# Exemple de variables pour docker-compose.prod.yml (à définir sur le serveur ou via le pipeline)

# Domaine public
DOMAIN=sigac.votre-domaine.tld

# Base de données
POSTGRES_DB=sigac_db
POSTGRES_USER=sigac_user
POSTGRES_PASSWORD=ChangeMeStrong!

# JWT secret (>= 32 chars)
JWT_SECRET=UnVraiSecretTresLongEtComplexe123!@#
