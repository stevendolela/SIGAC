# Frontend build (Vite) + Nginx static server with API reverse proxy
FROM node:18-alpine AS build
WORKDIR /app
COPY sigac-frontend/package.json sigac-frontend/package-lock.json ./sigac-frontend/
RUN cd sigac-frontend && npm ci
COPY sigac-frontend/ ./sigac-frontend/

# Ensure production API path defaults to /api when not provided
ENV VITE_API_URL=/api
RUN cd sigac-frontend && npm run build

FROM nginx:alpine AS final
WORKDIR /usr/share/nginx/html

# Copy built frontend
COPY --from=build /app/sigac-frontend/dist/ .

# Nginx config
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
