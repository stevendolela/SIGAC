# ==============================================
# SIGAC - Configuration Sécurisée (EXEMPLE)
# ==============================================
# NE PAS committer le fichier .env avec les vraies valeurs !
# Copier ce fichier en .env et remplir avec vos valeurs

# Base de données
DB_HOST=localhost
DB_PORT=5434
DB_NAME=sigac_db
DB_USER=sigac_user
DB_PASSWORD=VotreMotDePasseSecurise123!

# JWT Configuration
JWT_SECRET_KEY=VotreCleSecreteJWTGenereeAvecOpenSSL_MinimumXXXCaracteres
JWT_ISSUER=SIGAC.CourConstitutionnelle.RDC
JWT_AUDIENCE=SIGAC.Client
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# SMTP Configuration
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=votre-email@example.com
SMTP_PASSWORD=VotreMotDePasseEmail
SMTP_FROM=no-reply@courconstitutionnelle.cd
SMTP_SSL=true

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Stockage de fichiers
FILE_STORAGE_PATH=/tmp/sigac_uploads

# CORS Origins (séparés par des virgules)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5674

# Sécurité
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=24
ENABLE_RATE_LIMITING=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Environnement
ASPNETCORE_ENVIRONMENT=Development
