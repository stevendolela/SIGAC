{
  "version": 2,
  "name": "sigac-frontend",
  "buildCommand": "cd sigac-frontend && rm -rf node_modules/.vite dist && npm ci && npm run build",
  "outputDirectory": "sigac-frontend/dist",
  "devCommand": "cd sigac-frontend && npm run dev",
  "framework": "vite",
  "installCommand": "cd sigac-frontend && npm ci",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "VITE_API_URL": "https://sigac-backend-api.onrender.com/api"
  },
  "build": {
    "env": {
      "NODE_VERSION": "20"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
