import { useEffect, useState } from 'react'
import { dossierApi } from '../api/dossierApi'
import { documentApi, type DocumentVisualisationLogDto } from '../api/documentApi'
import { userApi } from '../api/userApi'
import type { DossierDetailDto } from '../types/dossierDetail'
import type { DocumentDto } from '../types/document'
import type { UserDto } from '../types/user'
import { useToast } from '../components/common/ToastProvider'
import AudienceList from '../components/audiences/AudienceList'
import AudienceForm from '../components/audiences/AudienceForm'
import Modal from '../components/common/Modal'

interface Props {
  dossierId: string
}

export default function DossierDetailPage({ dossierId }: Props) {
  const [detail, setDetail] = useState<DossierDetailDto | null>(null)
  const [docs, setDocs] = useState<DocumentDto[]>([])
  const [visualisations, setVisualisations] = useState<DocumentVisualisationLogDto[]>([])
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState<string | null>(null)
  const [rapporteurId, setRapporteurId] = useState('')
  const [juges, setJuges] = useState<UserDto[]>([])
  const [nouveauStatut, setNouveauStatut] = useState('')
  const [commentaire, setCommentaire] = useState('')
  const [showVisHistory, setShowVisHistory] = useState(false)
  const [viewerDoc, setViewerDoc] = useState<{ blob: Blob; name: string } | null>(null)
  const [showAudienceModal, setShowAudienceModal] = useState(false)
  const [selectedAudienceId, setSelectedAudienceId] = useState<string | undefined>()
  const [audienceRefreshKey, setAudienceRefreshKey] = useState(0)
  const [selectedFile, setSelectedFile] = useState<File | null>(null)
  const [typeDocument, setTypeDocument] = useState('Document')
  const [uploading, setUploading] = useState(false)
  const { notify } = useToast()

  // Helper functions pour les badges
  function getStatusBadge(status?: string | null) {
    const colors: Record<string, { bg: string; text: string; label: string }> = {
      'Nouveau': { bg: '#dbeafe', text: '#1e40af', label: '🆕 Nouveau' },
      'EnInstruction': { bg: '#fef3c7', text: '#92400e', label: '📝 En Instruction' },
      'EnDelibere': { bg: '#e0e7ff', text: '#3730a3', label: '💭 En Délibéré' },
      'Juge': { bg: '#d1fae5', text: '#065f46', label: '✅ Jugé' },
      'Classe': { bg: '#f3f4f6', text: '#374151', label: '📦 Classé' }
    }
    const config = colors[status || ''] || { bg: '#f3f4f6', text: '#6b7280', label: status || '-' }
    return (
      <span style={{
        padding: '6px 12px',
        borderRadius: 6,
        fontSize: 13,
        fontWeight: 600,
        background: config.bg,
        color: config.text,
        display: 'inline-block'
      }}>
        {config.label}
      </span>
    )
  }

  function getPriorityBadge(priority?: string | null) {
    const colors: Record<string, { bg: string; text: string; icon: string }> = {
      'Normale': { bg: '#e0e7ff', text: '#3730a3', icon: '📋' },
      'Haute': { bg: '#fef3c7', text: '#92400e', icon: '⚠️' },
      'Critique': { bg: '#fee2e2', text: '#991b1b', icon: '🔥' }
    }
    const config = colors[priority || ''] || { bg: '#f3f4f6', text: '#6b7280', icon: '📌' }
    return (
      <span style={{
        padding: '4px 10px',
        borderRadius: 4,
        fontSize: 12,
        fontWeight: 600,
        background: config.bg,
        color: config.text,
        display: 'inline-block'
      }}>
        {config.icon} {priority || '-'}
      </span>
    )
  }

  useEffect(() => {
    let mounted = true
    ;(async () => {
      setLoading(true)
      setError(null)
      try {
        const [d, l, j] = await Promise.all([
          dossierApi.getById(dossierId),
          documentApi.listByDossier(dossierId),
          userApi.listJuges()
        ])
        if (!mounted) return
        setDetail(d)
        setDocs(l)
        setJuges(j)
      } catch (e: any) {
        if (mounted) setError(e?.response?.data?.message || e?.message || 'Erreur de chargement')
      } finally {
        if (mounted) setLoading(false)
      }
    })()
    return () => { mounted = false }
  }, [dossierId])

  async function download(doc: DocumentDto) {
    try {
      const blob = await documentApi.download(doc.id)
      const url = URL.createObjectURL(blob)
      const a = document.createElement('a')
      a.href = url
      a.download = doc.nomFichier
      a.click()
      URL.revokeObjectURL(url)
      notify({ type: 'success', message: '📥 Document téléchargé' })
    } catch (e) {
      setError('Téléchargement impossible')
      notify({ type: 'error', message: 'Téléchargement impossible' })
    }
  }

  async function viewDocument(doc: DocumentDto) {
    try {
      const blob = await documentApi.view(doc.id)
      // Ouvrir dans le viewer intégré
      setViewerDoc({ blob, name: doc.nomFichier })
      notify({ type: 'success', message: '👁️ Document ouvert' })
      // Recharger l'historique si affiché
      if (showVisHistory) {
        setTimeout(() => loadVisualisations(), 500)
      }
    } catch (e) {
      setError('Visualisation impossible')
      notify({ type: 'error', message: 'Visualisation impossible' })
    }
  }

  async function loadVisualisations() {
    try {
      const vis = await documentApi.getDossierVisualisations(dossierId)
      setVisualisations(vis)
    } catch (e) {
      console.error('Erreur chargement historique visualisations', e)
    }
  }

  async function toggleVisHistory() {
    if (!showVisHistory) {
      await loadVisualisations()
    }
    setShowVisHistory(!showVisHistory)
  }

  async function remove(doc: DocumentDto) {
    if (!confirm('Supprimer ce document ?')) return
    try {
      const ok = await documentApi.remove(doc.id)
      if (ok) setDocs(prev => prev.filter(d => d.id !== doc.id))
      if (ok) notify({ type: 'success', message: 'Document supprimé' })
    } catch (e: any) {
      setError(e?.response?.data?.message || e?.message || 'Suppression impossible')
      notify({ type: 'error', message: e?.response?.data?.message || e?.message || 'Suppression impossible' })
    }
  }

  async function handleUpload() {
    if (!selectedFile) {
      notify({ type: 'error', message: 'Veuillez sélectionner un fichier' })
      return
    }

    setUploading(true)
    setError(null)
    
    try {
      const newDoc = await documentApi.upload(dossierId, selectedFile, typeDocument)
      setDocs(prev => [...prev, newDoc])
      setSelectedFile(null)
      setTypeDocument('Document')
      // Reset file input
      const fileInput = document.getElementById('file-input') as HTMLInputElement
      if (fileInput) fileInput.value = ''
      
      notify({ type: 'success', message: `✅ Document "${selectedFile.name}" uploadé avec succès` })
    } catch (e: any) {
      const errorMsg = e?.response?.data?.message || e?.message || 'Upload impossible'
      setError(errorMsg)
      notify({ type: 'error', message: errorMsg })
    } finally {
      setUploading(false)
    }
  }

  function handleFileChange(e: React.ChangeEvent<HTMLInputElement>) {
    const file = e.target.files?.[0]
    if (file) {
      setSelectedFile(file)
      setError(null)
    }
  }

  async function attribuerRapporteur() {
    try {
      if (!rapporteurId) { setError('Veuillez saisir un rapporteurId'); return }
      await dossierApi.attribuerRapporteur(dossierId, rapporteurId)
      setRapporteurId('')
      notify({ type: 'success', message: 'Rapporteur attribué' })
      // Pas de refresh lourd ici; un message ou toast serait idéal
    } catch (e: any) {
      setError(e?.response?.data?.message || e?.message || "Attribution du rapporteur impossible")
      notify({ type: 'error', message: e?.response?.data?.message || e?.message || 'Attribution du rapporteur impossible' })
    }
  }

  async function changerStatut() {
    try {
      if (!nouveauStatut) { 
        setError('Veuillez choisir un statut')
        notify({ type: 'error', message: 'Veuillez choisir un statut' })
        return 
      }
      
      // Convertir le statut en nombre (StatusDossier enum côté backend)
      const statutNumber = Number(nouveauStatut)
      
      await dossierApi.changerStatut(dossierId, statutNumber, commentaire)
      setCommentaire('')
      setNouveauStatut('')
      
      // Recharger le détail pour refléter le nouveau statut
      const d = await dossierApi.getById(dossierId)
      setDetail(d)
      notify({ type: 'success', message: `✅ Statut modifié avec succès` })
    } catch (e: any) {
      const errorMsg = e?.response?.data?.message || e?.message || 'Changement de statut impossible'
      setError(errorMsg)
      notify({ type: 'error', message: errorMsg })
    }
  }

  function handleAudienceSuccess() {
    setShowAudienceModal(false)
    setSelectedAudienceId(undefined)
    setAudienceRefreshKey(prev => prev + 1)
    notify({ type: 'success', message: '✅ Audience enregistrée avec succès' })
  }

  function handleAudienceSelect(id: string) {
    setSelectedAudienceId(id)
    setShowAudienceModal(true)
  }

  function handleNewAudience() {
    setSelectedAudienceId(undefined)
    setShowAudienceModal(true)
  }

  // Composants helper
  function InfoCard({ title, icon, children }: { title: string; icon?: string; children: React.ReactNode }) {
    return (
      <div style={{
        background: 'white',
        border: '1px solid #e2e8f0',
        borderRadius: 12,
        padding: 20,
        boxShadow: '0 1px 3px rgba(0,0,0,0.05)'
      }}>
        <div style={{ 
          fontSize: 14, 
          fontWeight: 600, 
          color: '#475569', 
          marginBottom: 16,
          display: 'flex',
          alignItems: 'center',
          gap: 8
        }}>
          {icon && <span>{icon}</span>}
          <span>{title}</span>
        </div>
        {children}
      </div>
    )
  }

  function InfoRow({ label, value }: { label: string; value: string }) {
    return (
      <div style={{ marginBottom: 12, display: 'flex', justifyContent: 'space-between', gap: 16 }}>
        <span style={{ color: '#64748b', fontSize: 13 }}>{label}:</span>
        <span style={{ color: '#1e293b', fontSize: 13, fontWeight: 500, textAlign: 'right' }}>{value}</span>
      </div>
    )
  }

  return (
    <Modal isOpen onClose={() => {}} size="xl">
      <div style={{ maxHeight: '85vh', overflowY: 'auto' }}>
        {loading && (
          <div style={{ padding: 40, textAlign: 'center' }}>
            <div className="spinner" style={{ margin: '0 auto 16px' }}></div>
            <p style={{ color: '#64748b' }}>Chargement du dossier...</p>
          </div>
        )}
        
        {error && (
          <div style={{ 
            padding: 24, 
            background: '#fef2f2', 
            border: '1px solid #fecaca', 
            borderRadius: 8,
            color: '#991b1b'
          }}>
            <strong>❌ Erreur:</strong> {error}
          </div>
        )}
        
        {detail && (
          <div>
            {/* En-tête moderne */}
            <div style={{ 
              background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
              padding: '24px 32px',
              borderRadius: '12px 12px 0 0',
              color: 'white',
              marginBottom: 24
            }}>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'start' }}>
                <div>
                  <div style={{ fontSize: 13, opacity: 0.9, marginBottom: 4 }}>
                    📋 {detail.numeroDossier}
                  </div>
                  <h2 style={{ margin: 0, fontSize: 24, fontWeight: 600 }}>
                    {detail.titre}
                  </h2>
                </div>
                <div style={{ textAlign: 'right' }}>
                  {getStatusBadge(detail.status)}
                  <div style={{ marginTop: 8, fontSize: 13, opacity: 0.9 }}>
                    {getPriorityBadge(detail.priorite)}
                  </div>
                </div>
              </div>
            </div>

            {/* Grille d'informations */}
            <div style={{ 
              display: 'grid', 
              gridTemplateColumns: 'repeat(auto-fit, minmax(280px, 1fr))',
              gap: 16,
              padding: '0 32px',
              marginBottom: 24
            }}>
              {/* Parties */}
              <InfoCard title="👥 Parties" icon="⚖️">
                <InfoRow label="Demandeur" value={detail.demandeur} />
                {detail.defendeur && <InfoRow label="Défendeur" value={detail.defendeur} />}
              </InfoCard>

              {/* Juge assigné */}
              <InfoCard title="👨‍⚖️ Juge rapporteur" icon="🎯">
                {detail.rapporteur ? (
                  <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
                    <div style={{ 
                      width: 40, 
                      height: 40, 
                      borderRadius: '50%', 
                      background: '#ddd6fe',
                      display: 'flex',
                      alignItems: 'center',
                      justifyContent: 'center',
                      fontSize: 18,
                      fontWeight: 600,
                      color: '#5b21b6'
                    }}>
                      {(detail.rapporteur.nomComplet || detail.rapporteur.username).charAt(0).toUpperCase()}
                    </div>
                    <div>
                      <div style={{ fontWeight: 600, color: '#1e293b' }}>
                        {detail.rapporteur.nomComplet || detail.rapporteur.username}
                      </div>
                      <div style={{ fontSize: 12, color: '#64748b' }}>
                        {detail.rapporteur.email}
                      </div>
                    </div>
                  </div>
                ) : (
                  <div style={{ color: '#94a3b8', fontStyle: 'italic' }}>
                    Aucun juge assigné
                  </div>
                )}
              </InfoCard>

              {/* Informations générales */}
              <InfoCard title="📊 Informations" icon="ℹ️">
                <InfoRow label="Type d'affaire" value={detail.typeAffaire || '-'} />
                <InfoRow 
                  label="Date de dépôt" 
                  value={detail.dateDebut ? new Date(detail.dateDebut).toLocaleDateString('fr-FR') : '-'} 
                />
              </InfoCard>
            </div>

            {/* Description */}
            {detail.description && (
              <div style={{ padding: '0 32px', marginBottom: 24 }}>
                <div style={{ 
                  background: '#f8fafc', 
                  border: '1px solid #e2e8f0',
                  borderRadius: 8,
                  padding: 16
                }}>
                  <div style={{ fontSize: 13, fontWeight: 600, color: '#475569', marginBottom: 8 }}>
                    📝 Description
                  </div>
                  <div style={{ color: '#334155', lineHeight: 1.6 }}>
                    {detail.description}
                  </div>
                </div>
              </div>
            )}

          <div className="panel" style={{ marginTop: 12 }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 12 }}>
              <div className="panel-title">Documents</div>
              <button className="btn" onClick={toggleVisHistory} style={{ fontSize: 13 }}>
                {showVisHistory ? '🔽 Masquer historique' : '📊 Voir historique visualisations'}
              </button>
            </div>

            {/* Formulaire d'upload */}
            <div style={{ 
              marginBottom: 16, 
              padding: 16, 
              background: '#f8fafc', 
              borderRadius: 8, 
              border: '1px solid #e2e8f0' 
            }}>
              <div style={{ fontSize: 14, fontWeight: 600, marginBottom: 12, color: '#1e293b' }}>
                📤 Uploader un document
              </div>
              <div style={{ display: 'flex', gap: 8, alignItems: 'center', flexWrap: 'wrap' }}>
                <input
                  id="file-input"
                  type="file"
                  onChange={handleFileChange}
                  accept=".pdf,.jpg,.jpeg,.png,.tiff,.doc,.docx,.xls,.xlsx,.zip"
                  style={{ 
                    padding: 8, 
                    border: '1px solid #cbd5e1', 
                    borderRadius: 6,
                    flex: 1,
                    minWidth: 200
                  }}
                />
                <select
                  value={typeDocument}
                  onChange={(e) => setTypeDocument(e.target.value)}
                  style={{ 
                    padding: 8, 
                    border: '1px solid #cbd5e1', 
                    borderRadius: 6 
                  }}
                >
                  <option value="Document">Document</option>
                  <option value="Requête">Requête</option>
                  <option value="Pièce justificative">Pièce justificative</option>
                  <option value="Rapport">Rapport</option>
                  <option value="Décision">Décision</option>
                  <option value="Autre">Autre</option>
                </select>
                <button 
                  className="btn" 
                  onClick={handleUpload}
                  disabled={!selectedFile || uploading}
                  style={{
                    opacity: !selectedFile || uploading ? 0.5 : 1,
                    cursor: !selectedFile || uploading ? 'not-allowed' : 'pointer'
                  }}
                >
                  {uploading ? '⏳ Upload...' : '📤 Uploader'}
                </button>
              </div>
              {selectedFile && (
                <div style={{ 
                  marginTop: 8, 
                  fontSize: 13, 
                  color: '#475569',
                  padding: 8,
                  background: '#e0f2fe',
                  borderRadius: 4
                }}>
                  📎 Fichier sélectionné: <b>{selectedFile.name}</b> ({(selectedFile.size / 1024).toFixed(1)} Ko)
                </div>
              )}
            </div>

            <div className="table-wrapper">
              <table className="table">
                <thead>
                  <tr>
                    <th>Nom</th>
                    <th>MIME</th>
                    <th>Taille</th>
                    <th>Version</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {docs.map(doc => (
                    <tr key={doc.id}>
                      <td>{doc.nomFichier}</td>
                      <td>{doc.mimeType}</td>
                      <td>{(doc.tailleFichier / 1024).toFixed(1)} Ko</td>
                      <td>{doc.numeroVersion}</td>
                      <td>
                        <button className="btn" onClick={() => viewDocument(doc)} title="Ouvrir dans le navigateur">👁️ Voir</button>{' '}
                        <button className="btn" onClick={() => download(doc)} title="Télécharger">📥 Télécharger</button>{' '}
                        <button className="btn" onClick={() => remove(doc)} title="Supprimer">🗑️ Supprimer</button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            
            {showVisHistory && (
              <div style={{ marginTop: 20, padding: 16, background: '#f8fafc', borderRadius: 8, border: '1px solid #e2e8f0' }}>
                <div style={{ fontSize: 16, fontWeight: 600, marginBottom: 12, color: '#1e293b' }}>
                  📊 Historique des Visualisations ({visualisations.length})
                </div>
                {visualisations.length === 0 ? (
                  <div style={{ color: '#64748b', fontSize: 14 }}>Aucune visualisation enregistrée</div>
                ) : (
                  <div style={{ maxHeight: 400, overflowY: 'auto' }}>
                    <table className="table" style={{ fontSize: 13 }}>
                      <thead>
                        <tr>
                          <th>Date/Heure</th>
                          <th>Utilisateur</th>
                          <th>Document</th>
                          <th>Type</th>
                          <th>IP</th>
                        </tr>
                      </thead>
                      <tbody>
                        {visualisations.map(v => (
                          <tr key={v.id}>
                            <td>{new Date(v.dateVisualisation).toLocaleString()}</td>
                            <td>{v.userNomComplet}</td>
                            <td>{v.documentNom}</td>
                            <td>
                              <span style={{ 
                                padding: '2px 8px', 
                                borderRadius: 4, 
                                fontSize: 11, 
                                fontWeight: 600,
                                background: v.typeVisualisation === 'view' ? '#dbeafe' : '#fef3c7',
                                color: v.typeVisualisation === 'view' ? '#1e40af' : '#92400e'
                              }}>
                                {v.typeVisualisation === 'view' ? '👁️ Vue' : '📥 Téléchargement'}
                              </span>
                            </td>
                            <td style={{ fontSize: 11, color: '#64748b' }}>{v.ipAddress || '-'}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
              </div>
            )}
          </div>

          <div className="panel" style={{ marginTop: 12, display: 'grid', gap: 12 }}>
            <div className="panel-title">Actions</div>
            <div style={{ display: 'flex', gap: 8, alignItems: 'center', flexWrap: 'wrap' }}>
              <select
                value={rapporteurId}
                onChange={(e) => setRapporteurId(e.target.value)}
                style={{ padding: 6, border: '1px solid #e5e7eb', borderRadius: 6, minWidth: 280 }}
              >
                <option value="">-- Sélectionner un juge --</option>
                {juges.map((juge) => (
                  <option key={juge.id} value={juge.id}>
                    {juge.nomComplet || juge.username} ({juge.matricule || juge.email})
                  </option>
                ))}
              </select>
              <button 
                className="btn" 
                onClick={attribuerRapporteur}
                disabled={!rapporteurId}
                style={{
                  opacity: !rapporteurId ? 0.5 : 1,
                  cursor: !rapporteurId ? 'not-allowed' : 'pointer'
                }}
              >
                Affecter le juge
              </button>
            </div>
            <div style={{ display: 'flex', gap: 8, alignItems: 'center', flexWrap: 'wrap' }}>
              <select
                value={nouveauStatut}
                onChange={(e) => setNouveauStatut(e.target.value)}
                style={{ padding: 6, border: '1px solid #e5e7eb', borderRadius: 6 }}
              >
                <option value="">Nouveau statut…</option>
                <option value="1">🆕 Nouveau</option>
                <option value="2">📝 En Instruction</option>
                <option value="3">💭 En Délibéré</option>
                <option value="4">✅ Jugé</option>
                <option value="5">📦 Classé</option>
              </select>
              <input
                placeholder="Commentaire (optionnel)"
                value={commentaire}
                onChange={(e) => setCommentaire(e.target.value)}
                style={{ padding: 6, border: '1px solid #e5e7eb', borderRadius: 6, minWidth: 300 }}
              />
              <button className="btn" onClick={changerStatut}>Changer statut</button>
            </div>
          </div>

          <div className="panel" style={{ marginTop: 12 }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 12 }}>
              <div className="panel-title">Audiences</div>
              <button className="btn" onClick={handleNewAudience} style={{ fontSize: 13 }}>
                📅 Planifier une audience
              </button>
            </div>
            <AudienceList
              key={audienceRefreshKey}
              dossierId={dossierId}
              onSelectAudience={handleAudienceSelect}
            />
          </div>

          {detail.historiques && detail.historiques.length > 0 && (
            <div className="panel" style={{ marginTop: 12 }}>
              <div className="panel-title">Historique</div>
              <ul>
                {detail.historiques.map(h => (
                  <li key={h.id}>
                    <b>{new Date(h.dateAction).toLocaleString()}</b>: {h.action} — {h.details ?? ''}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )}

      {/* Modal Viewer pour documents */}
      {viewerDoc && (
        <div
          style={{
            position: 'fixed',
            top: 0,
            left: 0,
            right: 0,
            bottom: 0,
            backgroundColor: 'rgba(0,0,0,0.8)',
            zIndex: 9999,
            display: 'flex',
            flexDirection: 'column',
            padding: '20px'
          }}
          onClick={() => setViewerDoc(null)}
        >
          <div
            style={{
              backgroundColor: '#fff',
              borderRadius: '8px',
              flex: 1,
              display: 'flex',
              flexDirection: 'column',
              overflow: 'hidden'
            }}
            onClick={(e) => e.stopPropagation()}
          >
            <div
              style={{
                padding: '16px 24px',
                borderBottom: '1px solid #e5e7eb',
                display: 'flex',
                justifyContent: 'space-between',
                alignItems: 'center'
              }}
            >
              <h3 style={{ margin: 0, fontSize: '18px', fontWeight: 600 }}>
                📄 {viewerDoc.name}
              </h3>
              <button
                onClick={() => setViewerDoc(null)}
                style={{
                  background: 'none',
                  border: 'none',
                  fontSize: '24px',
                  cursor: 'pointer',
                  color: '#6b7280',
                  padding: '4px 8px'
                }}
              >
                ✕
              </button>
            </div>
            <div style={{ flex: 1, overflow: 'auto' }}>
              <iframe
                src={URL.createObjectURL(viewerDoc.blob)}
                style={{
                  width: '100%',
                  height: '100%',
                  border: 'none'
                }}
                title={viewerDoc.name}
              />
            </div>
          </div>
        </div>
      )}

      {/* Modal Formulaire Audience */}
      <Modal
        isOpen={showAudienceModal}
        onClose={() => {
          setShowAudienceModal(false)
          setSelectedAudienceId(undefined)
        }}
        title={selectedAudienceId ? 'Modifier l\'audience' : 'Planifier une audience'}
        size="lg"
      >
        <AudienceForm
          audienceId={selectedAudienceId}
          dossierId={dossierId}
          onSuccess={handleAudienceSuccess}
          onCancel={() => {
            setShowAudienceModal(false)
            setSelectedAudienceId(undefined)
          }}
        />
      </Modal>
    </div>
  )
}
